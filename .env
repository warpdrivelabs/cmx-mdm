# cmx-mdm-server 环境变量（数据源等必填项见 mdm-server.toml / README）
RUST_LOG=info,cranelift_codegen=info,wasmtime_internal_cranelift=info,h2=info,tower=info,nacos_sdk=info

# 统一启动契约（与门户一致）：CONFIG_FILE 指定本仓 toml，ConfigManager 与 chassis 同源读取
#（[[databases]] / [auth] / [mdm.*] 全部来自该文件；Nacos 配置中心启用时在其上叠加远程配置）
CONFIG_FILE="./mdm-server.toml"

# ============================================
# Nacos 注册中心/配置中心接入（可选，默认全关）
# ============================================
# 开关与身份用新前缀（SERVICE_REGISTRY_* / CONFIG_CENTER_*）；连接参数（NACOS_SERVER_ADDR/
# NACOS_NAMESPACE/NACOS_USERNAME/NACOS_PASSWORD）代码只认 NACOS_* 名，保持旧名。
# ★新前缀开启必须显式配 TYPE=nacos（缺省 mock 不产生网络行为）；两中心可独立开启。
# 开启后 create 阶段强依赖 Nacos 可达（失败即中止启动）；register 失败仅 warn 不阻塞。
# 注册名是门户服务发现反代的约定键（[center_client.services].mdm 的 discovery）。

# SERVICE_REGISTRY_ENABLED=true
# SERVICE_REGISTRY_TYPE=nacos
# CONFIG_CENTER_ENABLED=true
# CONFIG_CENTER_TYPE=nacos
# NACOS_SERVER_ADDR=192.168.1.14:8848
# NACOS_NAMESPACE=dev13
# NACOS_USERNAME=admin
# NACOS_PASSWORD=nacos
# SERVICE_REGISTRY_NAME=cmx-mdm-server
# ★注册端口必填：本服务 HTTP 端口来自 MDM_PORT（不写 server.port），漏配会注册成 8080 错端口
# SERVICE_REGISTRY_PORT=8095
